{
  "name": "@ostico/bruno-mcp",
  "mcpName": "io.github.Ostico/bruno-mcp-studio",
  "version": "2.4.0",
  "description": "Author, edit and run Bruno API collections from an AI agent: non-destructive .bru/.yml editing at byte parity, execution groups, multi-identity auth testing, gRPC and WebSocket. No bru CLI.",
  "main": "dist/index.js",
  "bin": {
    "bruno-mcp": "dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts src/bruno/sandbox-worker.ts --format esm --sourcemap --clean --shims --dts",
    "typecheck": "tsc --noEmit",
    "dev": "ts-node-esm src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write src/",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "keywords": [
    "bruno",
    "bruno-mcp",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "api-testing",
    "api-client",
    "bru",
    "bru-files",
    "opencollection",
    "http-client",
    "rest-client",
    "test-automation",
    "integration-testing",
    "claude",
    "claude-code",
    "cursor",
    "ai-agent",
    "llm-tools",
    "postman-alternative",
    "authorization-testing",
    "api-security-testing",
    "bru-format"
  ],
  "author": "Ostico (https://github.com/Ostico)",
  "license": "MIT",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@usebruno/common": "^0.24.0",
    "@usebruno/lang": "^0.38.0",
    "@usebruno/query": "^0.2.2",
    "jsonc-parser": "^3.3.1",
    "tough-cookie": "^6.0.2",
    "undici": "^8.9.0",
    "ws": "^8.21.2",
    "yaml": "^2.9.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@usebruno/filestore": "^0.11.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "nanoid": "^3.3.17",
    "prettier": "^3.0.0",
    "socket.io": "^4.8.3",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ostico/bruno-mcp-studio.git"
  },
  "bugs": {
    "url": "https://github.com/Ostico/bruno-mcp-studio/issues"
  },
  "homepage": "https://github.com/Ostico/bruno-mcp-studio#readme"
}
